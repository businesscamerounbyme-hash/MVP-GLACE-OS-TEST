# Base Postgres (Neon). `neon link` / `neon env pull` remplissent ces deux valeurs.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"
# Connexion directe, utilisee uniquement par les migrations Prisma (db push / migrate).
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Signature des sessions JWT. Generer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Mot de passe du compte admin cree par prisma/seed.js. Requis pour lancer le seed.
SEED_ADMIN_PASSWORD="change-me"

# Agregateur Mobile Money actif : "simulation" en developpement.
PAYMENT_PROVIDER="simulation"
# Secret HMAC-SHA256 de verification des webhooks de paiement.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET="change-me"

# Prefill du bouton de demonstration admin sur /login, en developpement uniquement.
# L encart des comptes de demo n est jamais rendu en production.
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD="change-me"

# Envoi des emails de reinitialisation. Sans cle, le lien est ecrit dans la console
# du serveur au lieu d etre envoye — suffisant en developpement.
RESEND_API_KEY=""
EMAIL_EXPEDITEUR="GLACE OS <onboarding@resend.dev>"

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model Utilisateur {
  id           String      @id @default(cuid())
  /// Nom de famille. Sur les comptes anterieurs a la separation prenom/nom, ce champ
  /// contient encore le nom complet et prenom vaut null : nomComplet() gere les deux.
  nom          String
  prenom       String?
  /// URL de la photo de profil. Null tant que l utilisateur n en a pas televerse.
  photoUrl     String?
  email        String      @unique
  telephone    String
  motDePasse   String
  pays         String
  ville        String
  role         String      @default("MEMBER") // ADMIN, MODERATOR, SUPPLIER, MEMBER
  /// Date du dernier changement de mot de passe. Les jetons de session emis avant
  /// cette date sont refuses : reinitialiser doit deconnecter un intrus deja en place,
  /// sinon la reinitialisation ne sert a rien dans le cas ou elle est le plus utile.
  motDePasseModifieLe DateTime?
  dateCreation DateTime    @default(now())

  boutiques            Boutique[]
  avis                 Avis[]
  abonnementsMembre    AbonnementMembre[]
  actionsModeration    JournalModeration[]
  paiements            Paiement[]
  reinitialisations    ReinitialisationMotDePasse[]
}

model Boutique {
  id             String      @id @default(cuid())
  utilisateurId  String
  nom            String
  description    String
  pays           String
  ville          String
  quartier       String
  latitude       Float
  longitude      Float
  telephone      String
  whatsapp       String
  statut         String      @default("EN_ATTENTE") // EN_ATTENTE, PUBLIEE, REJETEE, INACTIVE
  badgeCertifie  Boolean     @default(false)
  noteMoyenne    Float       @default(0.0)
  dateValidation DateTime?
  dateCreation   DateTime    @default(now())

  utilisateur           Utilisateur             @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  offres                Offre[]
  propositionsProduits  PropositionProduit[]
  avis                  Avis[]
  abonnements           AbonnementFournisseur[]
  demandesBadges        DemandeBadge[]
  vues                  VueBoutique[]
  contacts              ContactBoutique[]
}

model ProduitReference {
  id               String   @id @default(cuid())
  nom              String   @unique
  categorie        String   // INGREDIENT, EMBALLAGE, EQUIPEMENT
  sousCategorie    String   // Stabilisants, Émulsifiants, Arômes, Pots, Cuillères, Turbines, etc.
  unitesAutorisees String   // Ex: "kg, sac 25kg, boîte 1kg, litre" (séparées par virgules)
  description      String?
  image            String?
  creePar          String?  // Id de l'admin ou system
  dateCreation     DateTime @default(now())

  offres Offre[]
}

model PropositionProduit {
  id            String   @id @default(cuid())
  boutiqueId    String
  nom           String
  categorie     String
  sousCategorie String
  description   String?
  statut        String   @default("EN_ATTENTE") // EN_ATTENTE, VALIDE, REJETE
  motifRejet    String?
  dateCreation  DateTime @default(now())

  boutique Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
}

model Offre {
  id                  String   @id @default(cuid())
  boutiqueId          String
  produitReferenceId  String
  prix                Float
  devise              String   @default("XOF") // XOF, XAF, GNF, USD
  unite               String   // ex: "kg", "sac 25kg", "litre"
  quantiteDisponible  Float    @default(1.0)
  photoUrl            String?
  description         String?
  dateCreation        DateTime @default(now())
  dateMiseAJour       DateTime @updatedAt

  boutique         Boutique         @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  produitReference ProduitReference @relation(fields: [produitReferenceId], references: [id], onDelete: Restrict)
}

model Avis {
  id            String   @id @default(cuid())
  boutiqueId    String
  utilisateurId String
  note          Int      // 1 à 5
  commentaire   String
  photoUrl      String?
  statut        String   @default("EN_ATTENTE") // EN_ATTENTE, PUBLIE, REJETE
  dateCreation  DateTime @default(now())

  boutique    Boutique    @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
}

model AbonnementFournisseur {
  id                    String    @id @default(cuid())
  boutiqueId            String
  statut                String    @default("ACTIF") // ACTIF, EXPIRE, EN_ATTENTE
  dateDebut             DateTime  @default(now())
  dateFin               DateTime
  montant               Float
  devise                String    @default("XOF")
  referenceMobileMoney  String
  operateur             String    // ORANGE_MONEY, MTN_MOMO, MOOV_MONEY, WAVE
  dateCreation          DateTime  @default(now())

  boutique Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
}

model AbonnementMembre {
  id                    String    @id @default(cuid())
  utilisateurId         String
  statut                String    @default("ACTIF") // ACTIF, EXPIRE, EN_ATTENTE
  dateDebut             DateTime  @default(now())
  dateFin               DateTime
  montant               Float
  devise                String    @default("XOF")
  referenceMobileMoney  String
  operateur             String    // ORANGE_MONEY, MTN_MOMO, MOOV_MONEY, WAVE
  dateCreation          DateTime  @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
}

model DemandeBadge {
  id                String    @id @default(cuid())
  boutiqueId        String
  statut            String    @default("EN_ATTENTE") // EN_ATTENTE, PAYEE, VALIDEE, REJETEE
  montant           Float     @default(15000)
  referencePaiement String?
  operateur         String?
  dateDemande       DateTime  @default(now())
  dateValidation    DateTime?

  boutique Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
}

model JournalModeration {
  id           String   @id @default(cuid())
  cibleId      String
  typeCible    String   // BOUTIQUE, PROPOSITION_PRODUIT, AVIS, DEMANDE_BADGE, UTILISATEUR
  moderateurId String
  action       String   // APPROUVER, REJETER, SUSPENDRE, MODIFIER_ROLE
  motif        String?
  dateAction   DateTime @default(now())

  moderateur Utilisateur @relation(fields: [moderateurId], references: [id], onDelete: Cascade)
}

/// Transaction Mobile Money. Source de verite du paiement : aucun droit (abonnement,
/// badge) n est accorde sans un Paiement passe a REUSSI par une confirmation verifiee
/// de l agregateur. La reponse du navigateur ne fait jamais autorite.
model Paiement {
  id               String    @id @default(cuid())
  utilisateurId    String
  type             String    // ABONNEMENT_MEMBRE, ABONNEMENT_FOURNISSEUR, DEMANDE_BADGE
  cibleId          String    // utilisateurId ou boutiqueId selon le type
  montant          Float     // issu du bareme serveur, jamais du client
  devise           String    @default("XOF")
  operateur        String    // ORANGE_MONEY, MTN_MOMO, MOOV_MONEY, WAVE
  numeroTelephone  String
  statut           String    @default("INITIE") // INITIE, EN_ATTENTE, REUSSI, ECHOUE, EXPIRE
  referenceInterne String    @unique // cle d idempotence cote GLACE OS
  referencePSP     String?   @unique // identifiant chez l agregateur
  payloadWebhook   String?   // trace brute recue, pour audit et litiges
  motifEchec       String?
  dateCreation     DateTime  @default(now())
  dateMiseAJour    DateTime  @updatedAt
  dateConfirmation DateTime?

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([statut])
  @@index([utilisateurId])
}

/// Tentatives de connexion, pour limiter le bourrage de mots de passe.
/// Stockees en base et non en memoire : chaque invocation serverless demarre avec un
/// process neuf, un compteur en RAM ne survivrait donc a aucune requete.
model TentativeConnexion {
  id         String   @id @default(cuid())
  /// Cle de regroupement : "email:<adresse>" ou "ip:<adresse>".
  cle        String
  reussie    Boolean  @default(false)
  dateEssai  DateTime @default(now())

  @@index([cle, dateEssai])
}

/// Demande de reinitialisation de mot de passe.
/// Le jeton n est jamais stocke en clair : seule son empreinte SHA-256 est conservee,
/// de sorte qu une fuite de la base ne permette pas de prendre la main sur les comptes.
model ReinitialisationMotDePasse {
  id            String    @id @default(cuid())
  utilisateurId String
  tokenHash     String    @unique
  expiration    DateTime
  utiliseLe     DateTime?
  dateCreation  DateTime  @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@index([expiration])
}

/// Marches ouverts a la creation de boutique.
///
/// Tous les pays africains sont visibles sur le site, mais un fournisseur ne peut
/// enregistrer une boutique que dans un pays ouvert par l administrateur. Cela evite
/// d afficher une carte vide dans des pays ou aucun approvisionnement n existe encore.
///
/// L absence de ligne vaut "ferme" : ouvrir un marche est un acte explicite.
model MarchePays {
  /// Code ISO 3166-1 alpha-2, cle canonique cote application.
  code           String    @id
  ouvert         Boolean   @default(false)
  dateOuverture  DateTime?
  modifiePar     String?
  dateMiseAJour  DateTime  @updatedAt

  @@index([ouvert])
}

/// Consultation d une fiche boutique.
///
/// Une ligne par visiteur, par boutique et par jour : la contrainte d unicite fait le
/// dedoublonnage en base plutot qu en code, ce qui resiste aux rafraichissements en
/// rafale comme aux requetes simultanees. Un compteur gonfle par des rechargements ne
/// vaut rien pour le fournisseur qui paie son abonnement dessus.
model VueBoutique {
  id          String   @id @default(cuid())
  boutiqueId  String
  /// Identifiant de visiteur tire d un cookie aleatoire. Jamais l adresse IP :
  /// la mesure d audience n a pas besoin d une donnee personnelle.
  visiteurCle String
  /// Jour au format AAAA-MM-JJ, porte par la contrainte d unicite.
  jour        String
  dateVue     DateTime @default(now())

  boutique Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@unique([boutiqueId, visiteurCle, jour])
  @@index([boutiqueId, dateVue])
}

/// Contact reellement declenche vers un fournisseur : appel ou WhatsApp.
///
/// C est la metrique qui compte pour lui — une vue mesure la curiosite, un contact
/// mesure une intention d achat. Dedoublonne par jour et par canal : la meme personne
/// qui clique trois fois reste un seul prospect.
model ContactBoutique {
  id           String   @id @default(cuid())
  boutiqueId   String
  visiteurCle  String
  /// TELEPHONE ou WHATSAPP.
  canal        String
  jour         String
  dateContact  DateTime @default(now())

  boutique Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@unique([boutiqueId, visiteurCle, canal, jour])
  @@index([boutiqueId, dateContact])
}
